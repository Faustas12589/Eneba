# Leave empty in dev (Vite proxies /api to localhost:8080).
# In production (Render static site) set to the backend URL, e.g. https://eneba-api.onrender.com
VITE_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
