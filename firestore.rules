// Firestore security rules. Paste into Firebase console > Firestore > Rules.
// Browsers never talk to Firestore directly: every read/write goes through the
// Go API, which uses the Admin SDK (service account) and bypasses these rules.
// So clients get no access at all. See DECISIONS.md #12.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
