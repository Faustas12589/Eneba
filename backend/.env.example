# Local dev works with no Firebase at all: STORE=memory serves embedded seed data.
STORE=memory
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Needed when STORE=firestore
FIREBASE_PROJECT_ID=
# Local: path to service-account JSON (never commit it)
GOOGLE_APPLICATION_CREDENTIALS=
# Render: paste the whole service-account JSON as the value
FIREBASE_CREDENTIALS_JSON=
